# Local Docker store settings. Copy to wordpress/local-store/.env (scripts/setup.sh does).
COMPOSE_PROJECT_NAME=claude-commerce-local

# WordPress is exposed to the host here.
WORDPRESS_PORT=8090
WORDPRESS_PUBLIC_URL=http://localhost:8090
WORDPRESS_IMAGE_TAG=php8.3-apache
WPCLI_IMAGE_TAG=cli-php8.3

# Local database only.
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=wordpress-root

# Local WordPress admin user only.
WORDPRESS_TITLE="ACME Supply Co."
WORDPRESS_TAGLINE="Tools and storage for the workshop bench"
WORDPRESS_ADMIN_USER=store_admin
WORDPRESS_ADMIN_PASSWORD=store-local-admin-password
WORDPRESS_ADMIN_EMAIL=admin@example.test

# Pin a WooCommerce version (empty installs the latest from WordPress.org).
WOOCOMMERCE_VERSION=
