# The merchant example's variables. Copy to merchant/.env. The repo-root .env is read
# after this file, so ANTHROPIC_API_KEY can live there and serve both examples.

# The local store: no WooCommerce site, no credential, no network. Comment this out to
# point the example at a real store with the variables below.
WOOCOMMERCE_LOCAL_STORE=1

# A WooCommerce store: the site URL (scheme included) and a REST API key with read/write
# permission (WooCommerce → Settings → Advanced → REST API). A WordPress user name and
# application password work in the same two variables. Over plain HTTP WooCommerce
# refuses Basic auth; wordpress/local-store/ configures its Docker site to accept it.
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Name recorded against each staged/applied change, and an optional display name for the
# store (defaults to the site title).
WOOCOMMERCE_OPERATOR=Operator
WOOCOMMERCE_STORE_NAME=

# Alert tuning: the fallback low-stock threshold, and the days a paid order may sit in
# "processing" before it counts as delayed.
WOOCOMMERCE_LOW_STOCK_DEFAULT=8
WOOCOMMERCE_FULFILMENT_SLA_DAYS=3

# 1 to skip WooCommerce Analytics and derive every metric from the trailing order scan.
WOOCOMMERCE_DISABLE_ANALYTICS=0

# Host approval is on by default: apply_change succeeds only for ids the portal's
# Approve route marked. 0 lets an approval typed in chat count (re-run the evals first).
MERCHANT_REQUIRE_HOST_APPROVAL=1

# The agent's conversation model lives in the repo-root .env, which is read after this
# file; an empty value here would shadow it, so leave the line commented.
# ANTHROPIC_API_KEY=
