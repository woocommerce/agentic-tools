# Settings for the storefront. Copy this file to .env here, or export the same names in
# the shell. Leave everything blank and the storefront runs anonymously against the Docker
# store from wordpress/local-store at http://localhost:8090. Real credentials do not belong
# in this file.
#
# The merchant side reads merchant/.env first and falls back to this file, so one
# ANTHROPIC_API_KEY here covers both. The merchant's own store and credential settings are
# described in merchant/.env.example.

# The WooCommerce site to shop, as a full URL including the scheme.
WOOCOMMERCE_STORE_URL=http://localhost:8090

# API key for the model that runs the conversation.
ANTHROPIC_API_KEY=

# Where the web app is served, used for links the host generates.
WEB_APP_URL=http://localhost:3006

# Presentation: a fixed hero tagline for sites that have none, and whether the product
# grid is pre-filled at startup (set 0 to skip it).
BRAND_TAGLINE=
CATALOG_WARMUP=1
